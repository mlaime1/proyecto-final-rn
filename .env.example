# Expo Public Variables (accessible in client bundle)
# These values are injected by Expo at build time.
# NEVER commit the real .env file to git.
#
# IMPORTANT SECURITY NOTE:
# The previous .env file was accidentally committed to the repository.
# Rotate the Supabase anon key in the Supabase dashboard before deploying.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key
# Optional. Only needed if the API service is enabled.
# EXPO_PUBLIC_API_URL=https://your-api.example.com
# Web Push PWA del barbero (T5). Pública: la usa el cliente para suscribirse.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Solo server: la privada NUNCA lleva prefijo EXPO_PUBLIC ni va al bundle.
# Se configura como secret remoto (`supabase secrets set VAPID_PRIVATE_KEY=...`).
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-email@example.com
