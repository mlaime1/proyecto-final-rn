{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // La Edge Function Deno (supabase/functions) usa tipos Deno / `npm:` que no
  // existen en el typecheck Expo: se valida con `supabase functions serve`.
  "exclude": ["node_modules", "supabase/functions"]
}
